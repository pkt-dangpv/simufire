&HEAD VERSION = 7600, TITLE = 'Simufire comparison: R0 large fast fire, window open from t=0, well-ventilated high-HRR' /

!! Scenario Configuration: tests post-flashover well-ventilated steady state.
!! Fire: fast growth (alpha=0.047 kW/s^2), peak 2000 kW, window open from t=0.
!! Expected: no O2 limitation (window supplies fresh air), T_upper > 400 C steady.
&TIME SIMULATION = 400 PRINT = 10 SMOKEVIEW = 10 SPREADSHEET = 10 /
&INIT PRESSURE = 101325 RELATIVE_HUMIDITY = 50 INTERIOR_TEMPERATURE = 20 EXTERIOR_TEMPERATURE = 20 /
&MISC LOWER_OXYGEN_LIMIT = 0.10 /

!! Material Properties
&MATL ID = 'CONCRETE' MATERIAL = 'Concrete Normal Weight (6 in)',
      CONDUCTIVITY = 1.75 DENSITY = 2200 SPECIFIC_HEAT = 1, THICKNESS = 0.15 EMISSIVITY = 0.94 /

!! Compartments (single room R0, 4x5x2.4m = 48 m^3)
&COMP ID = 'R0'
      DEPTH = 4.0 HEIGHT = 2.4 WIDTH = 5.0
      CEILING_MATL_ID = 'CONCRETE' WALL_MATL_ID = 'CONCRETE' FLOOR_MATL_ID = 'CONCRETE'
      ORIGIN = 0.0, 0.0, 0.0 GRID = 40, 32, 24 LEAK_AREA_RATIO = 0.00017, 5.2E-05 /

!! Wall Vents: window open from t=0 (same geometry as r0_hall_window_360 window)
&VENT TYPE = 'WALL' ID = 'R0 Window' COMP_IDS = 'R0' 'OUTSIDE' TOP = 2.0 BOTTOM = 0.8 WIDTH = 2.0
      CRITERION = 'TIME' T = 0, 400 F = 1, 1 FACE = 'FRONT' OFFSET = 1.5 /

!! Fire: fast growth wood fire, alpha=0.047 kW/s^2, peak 2000 kW
!! HRR(t) = 0.047 * t^2 until 2000 kW (reached ~t=206 s)
!! CO_YIELD same as reference (well-ventilated conditions expected throughout)
&FIRE ID = 'Room Fire' COMP_ID = 'R0', FIRE_ID = 'Fast Wood Fire' LOCATION = 2.5, 2.0 /
&CHEM ID = 'Fast Wood Fire' CARBON = 6 CHLORINE = 0 HYDROGEN = 10 NITROGEN = 0 OXYGEN = 5
      HEAT_OF_COMBUSTION = 18100 RADIATIVE_FRACTION = 0.35 /
&TABL ID = 'Fast Wood Fire' LABELS = 'TIME', 'HRR', 'HEIGHT', 'AREA', 'CO_YIELD', 'SOOT_YIELD', 'HCN_YIELD', 'HCL_YIELD', 'TRACE_YIELD' /
&TABL ID = 'Fast Wood Fire', DATA = 0,       0,  0, 0.001,  0.0062, 0.015, 0, 0, 0 /
&TABL ID = 'Fast Wood Fire', DATA = 30,      42, 0, 0.0454, 0.0062, 0.015, 0, 0, 0 /
&TABL ID = 'Fast Wood Fire', DATA = 60,     169, 0, 0.1565, 0.0062, 0.015, 0, 0, 0 /
&TABL ID = 'Fast Wood Fire', DATA = 90,     381, 0, 0.3058, 0.0062, 0.015, 0, 0, 0 /
&TABL ID = 'Fast Wood Fire', DATA = 120,    677, 0, 0.5012, 0.0062, 0.015, 0, 0, 0 /
&TABL ID = 'Fast Wood Fire', DATA = 150,   1058, 0, 0.7254, 0.0062, 0.015, 0, 0, 0 /
&TABL ID = 'Fast Wood Fire', DATA = 180,   1522, 0, 0.9578, 0.0062, 0.015, 0, 0, 0 /
&TABL ID = 'Fast Wood Fire', DATA = 210,   2000, 0, 1.2000, 0.0062, 0.015, 0, 0, 0 /
&TABL ID = 'Fast Wood Fire', DATA = 400,   2000, 0, 1.2000, 0.0062, 0.015, 0, 0, 0 /
&TABL ID = 'Fast Wood Fire', DATA = 410,      0, 0, 0.001,  0.0062, 0.015, 0, 0, 0 /

!! Devices
&DEVC ID = 'R0 Head Temp' COMP_ID = 'R0' LOCATION = 2.5, 2.0, 1.8 TYPE = 'THERMOCOUPLE' /

&TAIL /

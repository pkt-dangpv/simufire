&HEAD VERSION = 7600, TITLE = 'Simufire CMV-3: Window breaks at t=180s - glass failure, fresh-air ingress, HRR spike' /

!! Scenario Configuration
!! Sealed room until t=180s (same as single_room_closed), then window opens (glass failure).
!! Validates SimuFire glass break response: HRR boost from fresh O2, upper temp trajectory.
&TIME SIMULATION = 600 PRINT = 10 SMOKEVIEW = 10 SPREADSHEET = 10 /
&INIT PRESSURE = 101325 RELATIVE_HUMIDITY = 50 INTERIOR_TEMPERATURE = 20 EXTERIOR_TEMPERATURE = 20 /
&MISC LOWER_OXYGEN_LIMIT = 0.10 /

!! Material Properties
&MATL ID = 'CONCRETE' MATERIAL = 'Concrete Normal Weight (6 in)',
      CONDUCTIVITY = 1.75 DENSITY = 2200 SPECIFIC_HEAT = 1, THICKNESS = 0.15 EMISSIVITY = 0.94 /

!! Compartments
!! R0 = salon: 4 m deep x 5 m wide x 2.4 m high = 48 m^3
&COMP ID = 'R0'
      DEPTH = 4.0 HEIGHT = 2.4 WIDTH = 5.0
      CEILING_MATL_ID = 'CONCRETE' WALL_MATL_ID = 'CONCRETE' FLOOR_MATL_ID = 'CONCRETE'
      ORIGIN = 0.0, 0.0, 0.0 GRID = 40, 32, 24 LEAK_AREA_RATIO = 0.00017, 5.2E-05 /

!! Wall Vent: window closed initially, opens fully at t=180s (simulating glass failure)
!! Window: 1.2 m wide, sill at 0.8 m, lintel at 1.8 m (same geometry as r0_hall_window_360 window)
&VENT TYPE = 'WALL' ID = 'R0 Window Break' COMP_IDS = 'R0' 'OUTSIDE' TOP = 1.8 BOTTOM = 0.8 WIDTH = 1.2
      CRITERION = 'TIME' T = 0, 179, 180, 600 F = 0, 0, 1, 1 FACE = 'FRONT' OFFSET = 1.5 /

!! Fire: same slow wood fire as cfast_single_room_closed (alpha=0.0222 kW/s^2, peak 1280 kW)
&FIRE ID = 'Room Fire' COMP_ID = 'R0', FIRE_ID = 'Wood Fire' LOCATION = 2.5, 2.0 /
&CHEM ID = 'Wood Fire' CARBON = 6 CHLORINE = 0 HYDROGEN = 10 NITROGEN = 0 OXYGEN = 5
      HEAT_OF_COMBUSTION = 18100 RADIATIVE_FRACTION = 0.35 /
&TABL ID = 'Wood Fire' LABELS = 'TIME', 'HRR', 'HEIGHT', 'AREA', 'CO_YIELD', 'SOOT_YIELD', 'HCN_YIELD', 'HCL_YIELD', 'TRACE_YIELD' /
&TABL ID = 'Wood Fire', DATA = 0,    0,    0, 0.001,  0.0062, 0.015, 0, 0, 0 /
&TABL ID = 'Wood Fire', DATA = 30,   20,   0, 0.0314, 0.0062, 0.015, 0, 0, 0 /
&TABL ID = 'Wood Fire', DATA = 60,   80,   0, 0.0952, 0.0062, 0.015, 0, 0, 0 /
&TABL ID = 'Wood Fire', DATA = 90,   180,  0, 0.1821, 0.0062, 0.015, 0, 0, 0 /
&TABL ID = 'Wood Fire', DATA = 120,  320,  0, 0.2886, 0.0062, 0.015, 0, 0, 0 /
&TABL ID = 'Wood Fire', DATA = 150,  500,  0, 0.4124, 0.0062, 0.015, 0, 0, 0 /
&TABL ID = 'Wood Fire', DATA = 180,  720,  0, 0.5521, 0.0062, 0.015, 0, 0, 0 /
&TABL ID = 'Wood Fire', DATA = 210,  980,  0, 0.7065, 0.0062, 0.015, 0, 0, 0 /
&TABL ID = 'Wood Fire', DATA = 240, 1180,  0, 0.8400, 0.0062, 0.015, 0, 0, 0 /
&TABL ID = 'Wood Fire', DATA = 270, 1280,  0, 0.9000, 0.0062, 0.015, 0, 0, 0 /
&TABL ID = 'Wood Fire', DATA = 600, 1280,  0, 0.9000, 0.0062, 0.015, 0, 0, 0 /
&TABL ID = 'Wood Fire', DATA = 610,    0,  0, 0.001,  0.0062, 0.015, 0, 0, 0 /

!! Devices
&DEVC ID = 'R0 Head Temp' COMP_ID = 'R0' LOCATION = 2.5, 2.0, 1.8 TYPE = 'THERMOCOUPLE' /

&TAIL /

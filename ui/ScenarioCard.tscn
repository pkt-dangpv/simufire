[gd_scene load_steps=2 format=3]

; Una ficha de escenario de la lista del menu principal.
;
; Es un Button en modo interruptor para que la seleccion se vea, la lleve un
; ButtonGroup y el teclado la recorra solo. Los dos Labels van dentro con
; mouse_filter = 2 (IGNORE) para que el clic llegue al boton y no se lo coman.
;
; El texto lo pone MainMenu.gd desde get_preset_definitions(): "name" arriba y
; "description" abajo. No se inventa nada aqui.

[ext_resource type="FontFile" path="res://assets/fonts/bahnschrift.ttf" id="1_font"]

[node name="ScenarioCard" type="Button"]
custom_minimum_size = Vector2(0, 50)
toggle_mode = true
text = ""
clip_text = true

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 12.0
offset_top = 6.0
offset_right = -12.0
offset_bottom = -6.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 1

[node name="Name" type="Label" parent="Box"]
layout_mode = 2
mouse_filter = 2
theme_override_fonts/font = ExtResource("1_font")
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(0.9, 0.93, 0.95, 1)
text = "Escenario"
clip_text = true

[node name="Desc" type="Label" parent="Box"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.55, 0.6, 0.65, 1)
text = "descripcion"
clip_text = true

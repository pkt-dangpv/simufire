[gd_scene format=3]

[node name="GraphsViewer" type="Window"]
title = "Graficas de simulacion"
size = Vector2i(1500, 820)
min_size = Vector2i(960, 560)
visible = false
wrap_controls = false
force_native = true

[node name="Root" type="VBoxContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 4

[node name="Header" type="Label" parent="Root"]
layout_mode = 2
autowrap_mode = 3

[node name="ZoomBar" type="HBoxContainer" parent="Root"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="ZoomLabel" type="Label" parent="Root/ZoomBar"]
layout_mode = 2
text = "Zoom:"

[node name="BtnZoomOut" type="Button" parent="Root/ZoomBar"]
layout_mode = 2
text = "  -  "

[node name="BtnZoomIn" type="Button" parent="Root/ZoomBar"]
layout_mode = 2
text = "  +  "

[node name="BtnZoomReset" type="Button" parent="Root/ZoomBar"]
layout_mode = 2
text = "100%"

[node name="RoomNav" type="HBoxContainer" parent="Root"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="BtnRoomPrev" type="Button" parent="Root/RoomNav"]
layout_mode = 2
tooltip_text = "Sala anterior"
text = "<"

[node name="RoomSelector" type="OptionButton" parent="Root/RoomNav"]
layout_mode = 2
size_flags_horizontal = 3

[node name="BtnRoomNext" type="Button" parent="Root/RoomNav"]
layout_mode = 2
tooltip_text = "Sala siguiente"
text = ">"

[node name="Tabs" type="TabContainer" parent="Root"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_colors/font_selected_color = Color(0.94, 0.94, 0.9, 1)
theme_override_colors/font_unselected_color = Color(0.7, 0.72, 0.72, 1)
theme_override_font_sizes/font_size = 18

[node name="MessageLabel" type="Label" parent="Root"]
visible = false
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
autowrap_mode = 3

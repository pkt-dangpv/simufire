  "tactical_references": [
    {
      "reference_id": "nist_wind_flow_path",
      "source_id": "nist_wind",
      "topics": [
        "wind",
        "ventilation",
        "door_control",
        "external_water"
      ],
      "summary": "En los ensayos con viento, la VPP por sí sola no venció el flujo inducido. Combinada con control de puertas y otros medios de control y extinción mejoró las condiciones de la escalera.",
      "applicability": "Ensayos de incendios dominados por viento en edificio de siete plantas, Governors Island, febrero de 2008; instrumentos de temperatura, presión y velocidad.",
      "limitations": [
        "No permite recomendar ventilación solo a partir del caudal nominal del ventilador",
        "No fija un caudal universal de extinción ni garantiza condiciones seguras"
      ],
      "required_scenario_inputs": [
        "Wind direction/speed",
        "Inlet and outlet openings",
        "Door state and flow path",
        "Fire location and suppression status",
        "Crew/victim locations"
      ],
      "review_status": "expert_pending",
      "automatic_tactical_rule": false
    },
    {
      "reference_id": "nist_ppv_stair_pressure",
      "source_id": "nist_pressure",
      "topics": [
        "ventilation",
        "fan",
        "pressure"
      ],
      "summary": "La presurización obtenida depende de tamaño, número, orientación y posición de ventiladores y del estado de puertas y salidas. Las configuraciones deben evaluarse como sistema.",
      "applicability": "160 ensayos de presión en edificio vacío de oficinas de 30 plantas en Toledo; no convertir este protocolo de presurización en un ensayo de extinción.",
      "limitations": [
        "No traduce m³/h de catálogo directamente a presión de escalera",
        "No predice supervivencia individual ni comportamiento de un incendio concreto"
      ],
      "required_scenario_inputs": [
        "Building geometry",
        "Openings and leakage",
        "Fan arrangement and pressure/flow performance",
        "External conditions"
      ],
      "review_status": "expert_pending",
      "automatic_tactical_rule": false
    },

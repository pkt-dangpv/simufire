{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pipeline_version",
    "run_id",
    "scenario_id",
    "engine_sha256",
    "artifact_sha256",
    "runtime_versions"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "pipeline_version": {
      "enum": [
        "0.1",
        "0.2"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "engine_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario.json",
        "states.json",
        "thresholds.json",
        "knowledge.json",
        "events.json",
        "facts.json",
        "context.json"
      ],
      "properties": {
        "scenario.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "states.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "thresholds.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "knowledge.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "events.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "facts.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "context.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "runtime_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "jsonschema"
      ],
      "properties": {
        "python": {
          "type": "string",
          "minLength": 1
        },
        "jsonschema": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simufire.local/schemas/knowledge_entry.schema.json",
  "title": "SimuFire AI Knowledge Entry",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "knowledge_id",
    "topic",
    "title",
    "content",
    "source",
    "confidence",
    "tags"
  ],

  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },

    "knowledge_id": {
      "type": "string",
      "minLength": 1
    },

    "topic": {
      "type": "string",
      "enum": [
        "fire_dynamics",
        "hrr",
        "ventilation",
        "smoke_layer",
        "flashover",
        "backdraft",
        "rollover",
        "gas_flow",
        "oxygen",
        "temperature",
        "fire_growth",
        "suppression",
        "zone_models",
        "cfast",
        "fds",
        "simufire"
      ]
    },

    "title": {
      "type": "string",
      "minLength": 1
    },

    "content": {
      "type": "string",
      "minLength": 1
    },

    "source": {
      "$ref": "#/$defs/source"
    },

    "confidence": {
      "type": "string",
      "enum": [
        "authoritative",
        "high",
        "moderate"
      ]
    },

    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  },

  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "source_id",
        "title"
      ],

      "properties": {
        "source_id": {
          "type": "string"
        },

        "title": {
          "type": "string"
        },

        "organization": {
          "type": "string"
        },

        "document": {
          "type": "string"
        },

        "section": {
          "type": "string"
        },

        "page": {
          "type": [
            "integer",
            "string"
          ]
        },

        "url": {
          "type": "string"
        }
      }
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simufire.local/schemas/scenario.schema.json",
  "title": "SimuFire AI Scenario",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "scenario_id",
    "name",
    "simulation",
    "compartments",
    "openings",
    "fires",
    "actions"
  ],

  "properties": {
    "schema_version": {
      "type": "string"
    },

    "scenario_id": {
      "type": "string",
      "minLength": 1
    },

    "name": {
      "type": "string",
      "minLength": 1
    },

    "description": {
      "type": "string"
    },

    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_s",
        "time_step_s"
      ],
      "properties": {
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "time_step_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },

    "compartments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/compartment"
      }
    },

    "openings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/opening"
      }
    },

    "fires": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fire"
      }
    },

    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },

  "$defs": {
    "compartment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "width_m",
        "length_m",
        "height_m"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "width_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "length_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_m": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },

    "opening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "from",
        "to",
        "width_m",
        "height_m",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "door",
            "window",
            "vent"
          ]
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "width_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sill_height_m": {
          "type": "number",
          "minimum": 0
        },
        "state": {
          "type": "string",
          "enum": [
            "open",
            "closed"
          ]
        }
      }
    },

    "fire": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "compartment",
        "growth_model",
        "max_hrr_kw"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "compartment": {
          "type": "string"
        },
        "growth_model": {
          "type": "string",
          "enum": [
            "constant",
            "t_squared"
          ]
        },
        "alpha_kw_s2": {
          "type": "number",
          "minimum": 0
        },
        "max_hrr_kw": {
          "type": "number",
          "minimum": 0
        },
        "x_m": {
          "type": "number",
          "minimum": 0
        },
        "y_m": {
          "type": "number",
          "minimum": 0
        }
      }
    },

    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_s",
        "type",
        "target"
      ],
      "properties": {
        "time_s": {
          "type": "number",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "enum": [
            "open",
            "close",
            "break",
            "ignite",
            "extinguish",
            "apply_water"
          ]
        },
        "target": {
          "type": "string"
        }
      }
    }
  }
}
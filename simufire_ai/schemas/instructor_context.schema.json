{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simufire.local/schemas/instructor_context.schema.json",
  "title": "SimuFire AI Instructor Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "scenario_facts",
    "technical_knowledge",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_facts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "technical_knowledge": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_facts_are_authoritative",
        "knowledge_is_general_theory",
        "do_not_convert_association_into_causation",
        "do_not_invent_missing_variables",
        "do_not_invent_phenomena",
        "distinguish_scenario_from_general_theory"
      ],
      "properties": {
        "scenario_facts_are_authoritative": {
          "type": "boolean",
          "const": true
        },
        "knowledge_is_general_theory": {
          "type": "boolean",
          "const": true
        },
        "do_not_convert_association_into_causation": {
          "type": "boolean",
          "const": true
        },
        "do_not_invent_missing_variables": {
          "type": "boolean",
          "const": true
        },
        "do_not_invent_phenomena": {
          "type": "boolean",
          "const": true
        },
        "distinguish_scenario_from_general_theory": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "source_events": {
      "description": "Eventos del mismo anÃ¡lisis; evita consultar eventos de otro contexto.",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "analysis_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "compartments",
        "state_times_s",
        "supported_topics",
        "windows"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "compartments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string"
              }
            }
          }
        },
        "state_times_s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "supported_topics": {
          "const": [
            "hrr",
            "temperature",
            "smoke_layer",
            "oxygen",
            "ventilation",
            "ventilation_limited"
          ]
        },
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "topic",
              "compartment_id",
              "reference_time_s",
              "start_time_s",
              "end_time_s",
              "evaluable",
              "reason"
            ],
            "properties": {
              "topic": {
                "enum": [
                  "hrr",
                  "temperature",
                  "smoke_layer",
                  "oxygen",
                  "ventilation",
                  "ventilation_limited"
                ]
              },
              "compartment_id": {
                "type": "string",
                "minLength": 1
              },
              "reference_time_s": {
                "type": "number",
                "minimum": 0
              },
              "start_time_s": {
                "type": "number",
                "minimum": 0
              },
              "end_time_s": {
                "type": "number",
                "minimum": 0
              },
              "evaluable": {
                "type": "boolean"
              },
              "reason": {
                "enum": [
                  "requirements_met",
                  "sampling_gap",
                  "zero_hrr_baseline",
                  "ambiguous_interventions",
                  "no_opening_window",
                  "missing_pre_or_post_samples",
                  "insufficient_pre_history"
                ]
              }
            }
          }
        }
      }
    },
    "measurement_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario",
        "states",
        "thresholds"
      ],
      "properties": {
        "scenario": {
          "type": "object"
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "thresholds": {
          "type": "object"
        }
      },
      "description": "Original inputs of this analysis; validated individually and against events/coverage. Part of the context fingerprint."
    }
  }
}

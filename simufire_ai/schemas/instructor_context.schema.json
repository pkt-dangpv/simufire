{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simufire.local/schemas/instructor_context.schema.json",
  "title": "SimuFire AI Instructor Context",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "scenario_id",
    "scenario_facts",
    "technical_knowledge",
    "rules"
  ],

  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },

    "scenario_id": {
      "type": "string",
      "minLength": 1
    },

    "scenario_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },

    "technical_knowledge": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },

    "rules": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "scenario_facts_are_authoritative",
        "knowledge_is_general_theory",
        "do_not_convert_association_into_causation",
        "do_not_invent_missing_variables",
        "do_not_invent_phenomena",
        "distinguish_scenario_from_general_theory"
      ],

      "properties": {
        "scenario_facts_are_authoritative": {
          "type": "boolean",
          "const": true
        },

        "knowledge_is_general_theory": {
          "type": "boolean",
          "const": true
        },

        "do_not_convert_association_into_causation": {
          "type": "boolean",
          "const": true
        },

        "do_not_invent_missing_variables": {
          "type": "boolean",
          "const": true
        },

        "do_not_invent_phenomena": {
          "type": "boolean",
          "const": true
        },

        "distinguish_scenario_from_general_theory": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}